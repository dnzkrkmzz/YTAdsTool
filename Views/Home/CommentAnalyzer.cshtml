@model YTReklamAraci.Models.CommentAnalyzerViewModel
@{
    ViewData["Title"] = "Comment Analyzer";
}

<!-- Main Search Card -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
    <div class="card-body p-4">
        <form asp-action="CommentAnalyzer" method="post">
            <div class="row g-2 align-items-stretch" style="min-height: 52px;">
                <!-- Video URL Input -->
                <div class="col-lg-9 col-md-12">
                    <input type="text" asp-for="VideoUrl" class="form-control form-control-lg border-0 shadow-sm h-100" style="border-radius: 10px; background-color: #f8f9fa; font-size: 1rem;" placeholder="YouTube Video URL'si yapıştırın..." required>
                </div>
                <!-- Submit Button -->
                <div class="col-lg-3 col-md-12 mt-2 mt-lg-0">
                    <button type="submit" class="btn w-100 shadow-sm border-0 d-flex justify-content-center align-items-center gap-2 h-100 fw-bold" style="border-radius: 10px; background: linear-gradient(135deg, #f2994a, #f2c94c); color: white; font-size: 1rem;">
                        <i class="bi bi-chat-left-text-fill"></i> Yorumları Çek
                    </button>
                </div>
            </div>
        </form>

        <!-- Error Message -->
        @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
        {
            <div class="alert alert-danger mt-3 mb-0 border-0 shadow-sm" style="border-radius: 10px;">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ErrorMessage
            </div>
        }
    </div>
</div>

<!-- Results Section -->
@if (!string.IsNullOrEmpty(Model?.VideoTitle))
{
    <!-- Video Info Card -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
        <div class="card-body p-4 d-flex flex-column flex-md-row align-items-center gap-4">
            <img src="@Model.ThumbnailUrl" class="rounded shadow-sm" style="width: 160px; object-fit: cover;" alt="Thumbnail">
            <div>
                <h5 class="fw-bold mb-2 text-dark">@Model.VideoTitle</h5>
                <p class="text-muted small mb-2"><i class="bi bi-person-video me-1"></i> @Model.ChannelName</p>
                <span class="badge bg-light text-dark border shadow-sm">
                    <i class="bi bi-chat-dots text-primary me-1"></i> Toplam Yorum: @Model.TotalCommentCount?.ToString("N0")
                </span>
            </div>
        </div>
    </div>

    <!-- Comments List Card -->
    <div class="card border-0 shadow-sm" style="border-radius: 12px;">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-4 text-dark border-bottom pb-2">En Alakalı 50 Yorum</h5>
            
            <div class="row g-4">
                @if (Model.Comments != null && Model.Comments.Any())
                {
                    @foreach (var comment in Model.Comments)
                    {
                        <!-- Single Comment Item -->
                        <div class="col-12">
                            <div class="d-flex gap-3 bg-light p-3 rounded shadow-sm border-0">
                                <img src="@comment.AuthorProfileImageUrl" class="rounded-circle shadow-sm" style="width: 45px; height: 45px;" alt="Author">
                                <div class="w-100">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <h6 class="fw-bold m-0 text-dark" style="font-size: 0.95rem;">@comment.AuthorName</h6>
                                        <small class="text-muted" style="font-size: 0.8rem;">@comment.PublishedAt</small>
                                    </div>
                                    <p class="text-muted mb-2 small" style="white-space: pre-line;">@comment.TextOriginal</p>
                                    <div class="d-flex align-items-center gap-1 text-muted small">
                                        <i class="bi bi-hand-thumbs-up-fill text-secondary"></i> 
                                        <span class="fw-semibold">@comment.LikeCount?.ToString("N0")</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}