@model YTReklamAraci.Models.CommentAnalyzerViewModel

@{
    ViewData["Title"] = "Yorum Analizi";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-5"><i class="bi bi-chat-square-text text-danger"></i> Yorum & Kitle Analizi</h1>
        <p class="lead">Videonun kitlesinin ne konuştuğunu ve tepkilerini anında görün.</p>
    </div>

    <div class="row justify-content-center mb-4">
        <div class="col-md-8">
            <form asp-action="CommentAnalyzer" method="post" class="input-group shadow-sm mb-2">
                <input type="text" name="videoUrl" class="form-control form-control-lg" 
                       placeholder="YouTube Video Linkini Yapıştırın..." 
                       value="@Model.VideoUrl">
                <button class="btn btn-danger btn-lg" type="submit">Yorumları Getir</button>
            </form>
            
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-warning mt-3 text-center">@Model.ErrorMessage</div>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.VideoTitle))
    {
        <div class="row mb-4">
            <div class="col-md-12">
                <div class="card shadow-sm flex-md-row align-items-center p-3">
                    <img src="@Model.ThumbnailUrl" style="width: 200px; border-radius: 8px;" class="me-3 mb-3 mb-md-0" alt="Thumbnail">
                    <div>
                        <h5 class="fw-bold mb-1">@Model.VideoTitle</h5>
                        <p class="text-muted mb-2"><i class="bi bi-person-video"></i> @Model.ChannelName</p>
                        <span class="badge bg-primary fs-6">
                            <i class="bi bi-chat-dots"></i> Toplam Yorum: @Model.TotalCommentCount?.ToString("N0")
                        </span>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.Comments.Any())
        {
            <div class="row">
                <div class="col-12 mb-3">
                    <h5 class="text-muted border-bottom pb-2">En Popüler @Model.Comments.Count Yorum</h5>
                </div>
                @foreach (var comment in Model.Comments)
                {
                    <div class="col-md-6 mb-3">
                        <div class="card shadow-sm h-100 border-0">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="d-flex align-items-center">
                                        <img src="@comment.AuthorProfileImageUrl" class="rounded-circle me-2" style="width: 35px; height: 35px;">
                                        <span class="fw-bold small">@comment.AuthorName</span>
                                    </div>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-hand-thumbs-up text-primary"></i> @comment.LikeCount?.ToString("N0")
                                    </span>
                                </div>
                                <p class="card-text small text-muted mb-2" style="white-space: pre-wrap;">@comment.TextOriginal</p>
                                <div class="text-end text-black-50" style="font-size: 0.75rem;">
                                    @comment.PublishedAt
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>