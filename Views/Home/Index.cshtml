@model List<YTReklamAraci.Models.YoutubeVideo>

@{
    ViewData["Title"] = "YT Ads Tool";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-4">YT Ads Tool</h1>
        <p class="lead">Kelimeye göre hedeflenebilir video ve kanal listesi oluşturun.</p>
    </div>
    
    <div class="row justify-content-center mb-4">
        <div class="col-md-8">
            <form asp-action="Search" method="post" class="mb-4">
            <div class="row g-2 mb-3 align-items-stretch" style="min-height: 52px;">
                
                <div class="col-lg-6 col-md-12">
                    <input type="text" name="keyword" class="form-control form-control-lg shadow-sm border-light h-100" style="border-radius: 10px; font-size: 1rem;" placeholder="Anahtar kelime girin... (Örn: Video Hedefleme)" required>
                </div>
                
                <div class="col-lg-4 col-md-8 mt-2 mt-lg-0">
                    <div class="dropdown h-100">
                        <button class="btn btn-white bg-white w-100 shadow-sm border-light d-flex justify-content-between align-items-center h-100 text-nowrap" style="border-radius: 10px; color: #495057; font-size: 0.95rem;" type="button" id="excludeDropdown" data-bs-toggle="dropdown" aria-expanded="false" data-bs-auto-close="outside">
                            <span><span class="text-danger fw-bold me-1" style="font-size: 1.1rem;">✕</span> Kategori Hariç Tut</span>
                            <span class="caret text-muted small">▼</span>
                        </button>
                        <ul class="dropdown-menu w-100 shadow-lg border-0 p-3" aria-labelledby="excludeDropdown" style="max-height: 300px; overflow-y: auto; border-radius: 12px;">
                            <li><h6 class="dropdown-header text-danger fw-bold">Bu Kategorileri Gösterme:</h6></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><div class="form-check ms-2"><input class="form-check-input" type="checkbox" name="excludedCategories" value="10" id="cat10"><label class="form-check-label" for="cat10">🎵 Müzik</label></div></li>
                            <li><div class="form-check ms-2"><input class="form-check-input" type="checkbox" name="excludedCategories" value="25" id="cat25"><label class="form-check-label" for="cat25">📰 Haberler ve Politika</label></div></li>
                            <li><div class="form-check ms-2"><input class="form-check-input" type="checkbox" name="excludedCategories" value="20" id="cat20"><label class="form-check-label" for="cat20">🎮 Oyun</label></div></li>
                            <li><div class="form-check ms-2"><input class="form-check-input" type="checkbox" name="excludedCategories" value="24" id="cat24"><label class="form-check-label" for="cat24">🎭 Eğlence</label></div></li>
                            <li><div class="form-check ms-2"><input class="form-check-input" type="checkbox" name="excludedCategories" value="22" id="cat22"><label class="form-check-label" for="cat22">👤 Kişiler ve Bloglar</label></div></li>
                            <li><div class="form-check ms-2"><input class="form-check-input" type="checkbox" name="excludedCategories" value="17" id="cat17"><label class="form-check-label" for="cat17">⚽ Spor</label></div></li>
                            <li><div class="form-check ms-2"><input class="form-check-input" type="checkbox" name="excludedCategories" value="1" id="cat1"><label class="form-check-label" for="cat1">🎬 Film ve Animasyon</label></div></li>
                            <li><div class="form-check ms-2"><input class="form-check-input" type="checkbox" name="excludedCategories" value="27" id="cat27"><label class="form-check-label" for="cat27">📚 Eğitim</label></div></li>
                            <li><div class="form-check ms-2"><input class="form-check-input" type="checkbox" name="excludedCategories" value="28" id="cat28"><label class="form-check-label" for="cat28">🔬 Bilim ve Teknoloji</label></div></li>
                            <li><div class="form-check ms-2"><input class="form-check-input" type="checkbox" name="excludedCategories" value="26" id="cat26"><label class="form-check-label" for="cat26">👗 Nasıl Yapılır ve Stil</label></div></li>
                        </ul>
                    </div>
                </div>

                <div class="col-lg-2 col-md-4 mt-2 mt-lg-0">
                    <button type="submit" class="btn w-100 shadow-sm border-0 d-flex justify-content-center align-items-center gap-2 h-100 fw-bold" style="border-radius: 10px; background: linear-gradient(135deg, #ff416c, #ff4b2b); color: white; font-size: 1rem;">
                        <svg width="18" height="18" fill="currentColor" class="bi bi-crosshair" viewBox="0 0 16 16">
                        <path d="M8.5.5a.5.5 0 0 0-1 0v.518A7 7 0 0 0 1.018 7.5H.5a.5.5 0 0 0 0 1h.518A7 7 0 0 0 7.5 14.982v.518a.5.5 0 0 0 1 0v-.518A7 7 0 0 0 14.982 8.5h.518a.5.5 0 0 0 0-1h-.518A7 7 0 0 0 8.5 1.018V.5Zm-2 7.5a2 2 0 1 1 4 0 2 2 0 0 1-4 0Zm2-1a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z"/>
                        </svg>
                        Hedefle
                    </button>
                </div>
            </div>

                <div class="mt-2 text-center text-md-end">
                    <a class="text-decoration-none text-primary fw-bold" data-bs-toggle="collapse" href="#advancedSearchFilters" role="button" aria-expanded="false" aria-controls="advancedSearchFilters">
                        <small>Gelişmiş Filtreler ↓</small>
                    </a>
                </div>
                
                <div class="collapse mt-2 text-start" id="advancedSearchFilters">
                    <div class="card card-body bg-light border-0 shadow-sm" style="border-radius: 10px;">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label text-muted fw-bold" style="font-size: 0.85rem;">Sıralama</label>
                                <select name="sortBy" class="form-select form-select-sm">
                                    <option value="relevance">Alaka Düzeyi</option>
                                    <option value="date">En Yeni Videolar</option>
                                    <option value="viewCount">En Çok İzlenenler</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-muted fw-bold" style="font-size: 0.85rem;">Yüklenme Tarihi</label>
                                <select name="dateFilter" class="form-select form-select-sm">
                                    <option value="all">Farketmez</option>
                                    <option value="today">Bugün</option>
                                    <option value="week">Bu Hafta</option>
                                    <option value="month">Bu Ay</option>
                                    <option value="year">Bu Yıl</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-muted fw-bold" style="font-size: 0.85rem;">Video Süresi</label>
                                <select name="durationFilter" class="form-select form-select-sm">
                                    <option value="all">Farketmez</option>
                                    <option value="short">Kısa (< 4 dk)</option>
                                    <option value="medium">Orta (4-20 dk)</option>
                                    <option value="long">Uzun (> 20 dk)</option>
                                </select>
                            </div>
                            <div class="col-md-3 d-flex align-items-end pb-1">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="hdOnly" value="true" id="hdOnlySearchCheck">
                                    <label class="form-check-label text-muted fw-bold" style="font-size: 0.85rem;" for="hdOnlySearchCheck">
                                        Sadece HD Videolar
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
            
            <div class="text-center">
                <small class="text-muted d-block mb-3">Birden fazla kelimeyi virgül (,) ile ayırarak girebilirsiniz.</small>
                
                @if (ViewBag.TopTrends != null)
                {
                    var trends = ViewBag.TopTrends as List<string>;
                    if (trends != null && trends.Any())
                    {
                        <div class="d-flex justify-content-center align-items-center flex-wrap">
                            <span class="text-muted small me-2 mb-1">
                                <i class="bi bi-graph-up-arrow"></i> 🔥 Bugünün Trend Kelimeleri:
                            </span>
                            @foreach (var trend in trends)
                            {
                                <form asp-action="Search" method="post" class="d-inline">
                                    <input type="hidden" name="keyword" value="@trend" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill me-1 mb-1" title="@trend">
                                        @(trend.Length > 35 ? trend.Substring(0, 35) + "..." : trend)
                                    </button>
                                </form>
                            }
                        </div>
                    }
                }
                </div>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3>Sonuçlar (@Model.Count Video)</h3>
            
            @* Excel Formu *@
            <form asp-action="ExportToExcel" method="post">
                @for (int i = 0; i < Model.Count; i++)
                {
                    <input type="hidden" name="[@i].Title" value="@Model[i].Title" />
                    <input type="hidden" name="[@i].VideoUrl" value="@Model[i].VideoUrl" />
                    <input type="hidden" name="[@i].ChannelTitle" value="@Model[i].ChannelTitle" />
                    <input type="hidden" name="[@i].ViewCount" value="@Model[i].ViewCount" />
                    <input type="hidden" name="[@i].PublishedAt" value="@Model[i].PublishedAt" />
                }
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-file-earmark-excel"></i> Excel Olarak İndir
                </button>
            </form>
        </div>

        <div class="card shadow">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Video</th>
                            <th>Kanal</th>
                            <th>Kategori</th>
                            <th>İzlenme</th>
                            <th>Tarih</th>
                            <th>İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var video in Model)
                        {
                            <tr>
                                <td><small>@video.Title</small></td>
                                <td><small>@video.ChannelTitle</small></td>
                                <td><span class="badge bg-secondary text-light">@video.CategoryName</span></td>
                                <td><span class="badge bg-info text-dark">@video.ViewCount?.ToString("N0")</span></td>
                                <td><small>@video.PublishedAt</small></td>
                                <td>
                                    <a href="@video.VideoUrl" target="_blank" class="btn btn-outline-danger btn-sm">Aç</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (Model != null)
    {
        <div class="alert alert-info text-center">
            Arama yapmak için yukarıdaki kutucuğu kullanın.
        </div>
    }
</div>