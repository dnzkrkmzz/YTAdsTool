@model YTReklamAraci.Models.ChannelViewModel
@{
    ViewData["Title"] = "Channel Analyzer";
}

<div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
    <div class="card-body p-4">
        <form asp-action="ChannelAnalyzer" method="post">
            <div class="row g-2 align-items-stretch" style="min-height: 52px;">
                <div class="col-lg-9 col-md-12">
                    <input type="text" name="channelUrl" class="form-control form-control-lg border-0 shadow-sm h-100" style="border-radius: 10px; background-color: #f8f9fa; font-size: 1rem;" placeholder="Kanal linki, ID'si veya @@handle girin..." required>
                </div>
                <div class="col-lg-3 col-md-12 mt-2 mt-lg-0">
                    <button type="submit" class="btn w-100 shadow-sm border-0 d-flex justify-content-center align-items-center gap-2 h-100 fw-bold" style="border-radius: 10px; background: linear-gradient(135deg, #11998e, #38ef7d); color: white; font-size: 1rem;">
                        <i class="bi bi-bar-chart-fill"></i> Analiz Et
                    </button>
                </div>
            </div>
        </form>

        @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
        {
            <div class="alert alert-danger mt-3 mb-0 border-0 shadow-sm" style="border-radius: 10px;">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ErrorMessage
            </div>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(Model?.Title))
{
    <div class="card border-0 shadow-sm mb-4 overflow-hidden" style="border-radius: 12px;">
        @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
        {
            <div style="height: 150px; background-image: url('@Model.BannerImageUrl'); background-size: cover; background-position: center;"></div>
        }
        <div class="card-body p-4 position-relative">
            <div class="d-flex flex-column flex-md-row align-items-center gap-4">
                <img src="@Model.ProfileImageUrl" class="rounded-circle shadow" style="width: 100px; height: 100px; border: 4px solid white; margin-top: @(string.IsNullOrEmpty(Model.BannerImageUrl) ? "0" : "-50px");" alt="Profile">
                
                <div class="text-center text-md-start">
                    <h4 class="fw-bold mb-1">@Model.Title</h4>
                    <p class="text-muted small mb-2">Katılım: @Model.PublishedAt</p>
                    <span class="badge bg-light text-dark border shadow-sm">Kategori: @Model.ChannelCategory</span>
                </div>
                
                <div class="ms-md-auto d-flex gap-3 text-center mt-3 mt-md-0">
                    <div class="bg-light p-3 rounded shadow-sm border">
                        <h6 class="text-muted small mb-1 fw-bold">ABONE</h6>
                        <h5 class="m-0 text-dark">@Model.SubscriberCount?.ToString("N0")</h5>
                    </div>
                    <div class="bg-light p-3 rounded shadow-sm border">
                        <h6 class="text-muted small mb-1 fw-bold">İZLENME</h6>
                        <h5 class="m-0 text-dark">@Model.ViewCount?.ToString("N0")</h5>
                    </div>
                    <div class="bg-light p-3 rounded shadow-sm border">
                        <h6 class="text-muted small mb-1 fw-bold">VİDEO</h6>
                        <h5 class="m-0 text-dark">@Model.VideoCount?.ToString("N0")</h5>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius: 12px;">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3 border-bottom pb-2"><i class="bi bi-star-fill text-warning me-2"></i> En Popüler 5 Video</h5>
            <div class="table-responsive">
                <table class="table table-hover align-middle border">
                    <thead class="table-light text-muted">
                        <tr>
                            <th>Video Başlığı</th>
                            <th>Yayın Tarihi</th>
                            <th class="text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var video in Model.TopVideos)
                        {
                            <tr>
                                <td><small class="fw-semibold text-dark">@video.Title</small></td>
                                <td><small class="text-muted">@video.PublishedAt</small></td>
                                <td class="text-end">
                                    <a href="@video.VideoUrl" target="_blank" class="btn btn-outline-danger btn-sm rounded-pill px-3">Aç</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}