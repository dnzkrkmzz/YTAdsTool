@model YTReklamAraci.Models.ChannelViewModel

@{
    ViewData["Title"] = "Kanal Analiz Paneli";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-5"><i class="bi bi-person-badge text-danger"></i> Kanal Analiz Paneli</h1>
        <p class="lead">Bir kanalın performansını ve kitle büyüklüğünü derinlemesine inceleyin.</p>
    </div>

    <div class="row justify-content-center mb-5">
        <div class="col-md-8">
            <form asp-action="ChannelAnalyzer" method="post" class="input-group shadow-sm">
                <input type="text" name="channelUrl" class="form-control form-control-lg" placeholder="Kanal ID veya URL girin (Örn: UC... veya @@kanaladi)">
                <button class="btn btn-danger btn-lg" type="submit">Analiz Et</button>
            </form>
            @if (!string.IsNullOrEmpty(Model.ErrorMessage)) {
                <div class="alert alert-warning mt-3">@Model.ErrorMessage</div>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Title)) {
        <div class="card shadow border-0 overflow-hidden mb-5">
            @if (!string.IsNullOrEmpty(Model.BannerImageUrl)) {
                <div style="height: 200px; background: url('@Model.BannerImageUrl') center/cover;"></div>
            }
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-4">
                    <img src="@Model.ProfileImageUrl" class="rounded-circle border border-4 border-white shadow-sm" style="width: 100px; margin-top: -50px;">
                    <div class="ms-3">
                        <h2 class="mb-0">@Model.Title</h2>
                        <span class="text-muted">Kanal ID: @Model.ChannelId</span>
                    </div>
                </div>

                <div class="row text-center mb-4">
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded shadow-sm">
                            <h4 class="mb-0 fw-bold">@Model.SubscriberCount?.ToString("N0")</h4>
                            <small class="text-muted">Toplam Abone</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded shadow-sm">
                            <h4 class="mb-0 fw-bold">@Model.ViewCount?.ToString("N0")</h4>
                            <small class="text-muted">Toplam İzlenme</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded shadow-sm">
                            <h4 class="mb-0 fw-bold">@Model.VideoCount?.ToString("N0")</h4>
                            <small class="text-muted">Video Sayısı</small>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-7">
                        <h5>Kanal Açıklaması</h5>
                        <p class="text-muted small">@Model.Description</p>
                    </div>
                    <div class="col-md-5">
                        <h5>En Popüler Videolar</h5>
                        <div class="list-group list-group-flush">
                            @foreach (var video in Model.TopVideos) {
                                <a href="@video.VideoUrl" target="_blank" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0">
                                    <span class="text-truncate small me-2">@video.Title</span>
                                    <span class="badge bg-danger rounded-pill">İzle</span>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>