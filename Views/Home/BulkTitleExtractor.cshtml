@model List<YTReklamAraci.Models.YoutubeVideo>
@{
    ViewData["Title"] = "Bulk Title Extractor";
}

<div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
    <div class="card-body p-4">
        <form asp-action="BulkTitleExtractor" method="post">
            <div class="mb-3">
                <label class="form-label text-muted fw-bold small">
                    <i class="bi bi-link-45deg"></i> YouTube URL'lerini Yapıştırın (Her satıra bir link gelecek şekilde, max 2.500)
                </label>
                <textarea name="urls" class="form-control border-0 shadow-sm p-3" rows="8" style="border-radius: 10px; background-color: #f8f9fa; font-size: 0.95rem; resize: none;" placeholder="https://www.youtube.com/watch?v=...\nhttps://youtu.be/..." required></textarea>
            </div>
            
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted small"><i class="bi bi-info-circle"></i> Sistem otomatik olarak 50'şerli paketler halinde sorgulayacaktır.</span>
                <button type="submit" class="btn shadow-sm border-0 d-flex align-items-center gap-2 fw-bold px-4 py-2" style="border-radius: 10px; background: linear-gradient(135deg, #4facfe, #00f2fe); color: white;">
                    <i class="bi bi-lightning-charge-fill"></i> Başlıkları Getir
                </button>
            </div>
        </form>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger mt-3 mb-0 border-0 shadow-sm" style="border-radius: 10px;">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
            </div>
        }
    </div>
</div>

@if (Model != null && Model.Any())
{
    var successCount = Model.Count(m => m.Status == "Bulundu");
    var failCount = Model.Count(m => m.Status != "Bulundu");

    <div class="card border-0 shadow-sm" style="border-radius: 12px;">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                <div>
                    <h5 class="fw-bold m-0 text-dark mb-1">Analiz Tamamlandı</h5>
                    <span class="badge bg-success text-white me-2">@successCount Bulundu</span>
                    @if(failCount > 0) { <span class="badge bg-danger text-white">@failCount Hatalı/Gizli</span> }
                </div>
                
                <form asp-action="ExportBulkTitleToExcel" method="post">
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <input type="hidden" name="results[@i].OriginalUrl" value="@Model[i].OriginalUrl" />
                        <input type="hidden" name="results[@i].VideoId" value="@Model[i].VideoId" />
                        <input type="hidden" name="results[@i].Title" value="@Model[i].Title" />
                        <input type="hidden" name="results[@i].ChannelTitle" value="@Model[i].ChannelTitle" />
                        <input type="hidden" name="results[@i].CategoryName" value="@Model[i].CategoryName" />
                        <input type="hidden" name="results[@i].ViewCount" value="@Model[i].ViewCount" />
                        <input type="hidden" name="results[@i].Status" value="@Model[i].Status" />
                        <input type="hidden" name="results[@i].HasProfanity" value="@Model[i].HasProfanity.ToString().ToLower()" />
                    }
                    <button type="submit" class="btn btn-success shadow-sm d-flex align-items-center gap-2">
                        <i class="bi bi-file-earmark-excel"></i> Excel İndir
                    </button>
                </form>
            </div>

            <div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
                <table class="table table-hover align-middle border">
                    <thead class="table-light text-muted sticky-top">
                        <tr>
                            <th class="text-center">Durum</th>
                            <th style="width: 35%;">Video Başlığı</th>
                            <th>Kanal</th>
                            <th>Kategori</th>
                            <th class="text-center">İzlenme</th>
                            <th>Orijinal Link</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">
                                    @if(item.Status == "Bulundu") { <i class="bi bi-check-circle-fill text-success fs-5" title="Bulundu"></i> }
                                    else { <i class="bi bi-x-circle-fill text-danger fs-5" title="@item.Status"></i> }
                                </td>
                                <td>
                                    @if(item.Status == "Bulundu") 
                                    { 
                                        <small class="fw-semibold text-dark">@item.Title</small> 
                                        if(item.HasProfanity)
                                        {
                                            <span class="badge bg-danger text-white ms-2 shadow-sm" title="Başlık veya açıklamada uygunsuz kelime tespit edildi!">
                                                <i class="bi bi-exclamation-triangle-fill"></i> Riskli İçerik
                                            </span>
                                        }
                                    }
                                    else 
                                    { 
                                        <small class="text-danger fst-italic">@item.Status</small> 
                                    }
                                </td>
                                <td><small class="text-muted">@(item.ChannelTitle ?? "-")</small></td>
                                
                                <td>
                                    @if(!string.IsNullOrEmpty(item.CategoryName)) { <span class="badge bg-secondary text-light">@item.CategoryName</span> }
                                    else { <span>-</span> }
                                </td>

                                <td class="text-center">
                                    @if(item.ViewCount.HasValue) { <span class="badge bg-light text-dark border">@item.ViewCount?.ToString("N0")</span> }
                                    else { <span>-</span> }
                                </td>
                                <td>
                                    <div class="text-truncate" style="max-width: 200px;" title="@item.OriginalUrl">
                                        @{
                                            var safeUrl = item.OriginalUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase) 
                                                          ? item.OriginalUrl 
                                                          : "https://" + item.OriginalUrl;
                                        }
                                        <a href="@safeUrl" target="_blank" class="text-decoration-none small">@item.OriginalUrl</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}