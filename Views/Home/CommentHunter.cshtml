@model List<YTReklamAraci.Models.CommentHunterResult>
@{
    ViewData["Title"] = "Comment Hunter";
}

<!-- Main Search Card -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
    <div class="card-body p-4">
        <form asp-action="CommentHunter" method="post">
            <div class="row g-3 mb-3">
                <!-- Video Search Keywords -->
                <div class="col-md-6">
                    <label class="form-label text-muted fw-bold small">1. Video Arama Kelimeleri (Virgülle Ayırın)</label>
                    <input type="text" name="mainKeywords" class="form-control form-control-lg border-0 shadow-sm" style="border-radius: 10px; background-color: #f8f9fa; font-size: 0.95rem;" placeholder="Örn: saç dökülmesi, kellik, saç ekimi" value="@ViewBag.SearchedMainKeywords" required>
                </div>
                
                <!-- Comment Search Keywords -->
                <div class="col-md-6">
                    <label class="form-label text-muted fw-bold small">2. Yorumda Geçen Kelimeler (Virgülle Ayırın)</label>
                    <input type="text" name="commentKeywords" class="form-control form-control-lg border-0 shadow-sm" style="border-radius: 10px; background-color: #f8f9fa; font-size: 0.95rem;" placeholder="Örn: çare, çözüm, arıyorum, öneri" value="@ViewBag.SearchedCommentKeywords" required>
                </div>
            </div>

            <!-- Advanced Filters Toggle -->
            <div class="text-end mb-3">
                <a class="text-decoration-none text-primary fw-bold" data-bs-toggle="collapse" href="#advancedCommentFilters" role="button" aria-expanded="false" aria-controls="advancedCommentFilters">
                    <small>Gelişmiş Filtreler ↓</small>
                </a>
            </div>

            <!-- Advanced Filters Content -->
            <div class="collapse mb-3 text-start" id="advancedCommentFilters">
                <div class="p-3 bg-white border shadow-sm" style="border-radius: 10px;">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label text-muted fw-bold" style="font-size: 0.85rem;">Yüklenme Tarihi</label>
                            <select name="dateFilter" class="form-select form-select-sm">
                                <option value="any">Farketmez</option>
                                <option value="today">Bugün</option>
                                <option value="week">Bu Hafta</option>
                                <option value="month">Bu Ay</option>
                                <option value="year">Bu Yıl</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted fw-bold" style="font-size: 0.85rem;">Video Süresi</label>
                            <select name="durationFilter" class="form-select form-select-sm">
                                <option value="any">Farketmez</option>
                                <option value="short">Kısa (< 4 dk)</option>
                                <option value="medium">Orta (4-20 dk)</option>
                                <option value="long">Uzun (> 20 dk)</option>
                            </select>
                        </div>
                        <div class="col-md-4 d-flex align-items-end pb-1">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="hdOnly" value="true" id="hdOnlyCheck">
                                <label class="form-check-label text-muted fw-bold" style="font-size: 0.85rem;" for="hdOnlyCheck">
                                    Sadece HD Videolar
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn w-100 shadow-sm border-0 d-flex justify-content-center align-items-center gap-2 fw-bold py-3" style="border-radius: 10px; background: linear-gradient(135deg, #ff0844, #ffb199); color: white; font-size: 1.1rem;">
                <i class="bi bi-search"></i> Potansiyel Müşterileri Avla
            </button>
        </form>

        <!-- Error Message -->
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger mt-3 mb-0 border-0 shadow-sm" style="border-radius: 10px;">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
            </div>
        }
    </div>
</div>

<!-- Results Section -->
@if (Model != null && Model.Any())
{
    <div class="card border-0 shadow-sm" style="border-radius: 12px;">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-3">
                <h5 class="fw-bold m-0 text-dark">
                    Hedef Kitle Bulundu! <span class="text-success fs-6 ms-2">(@Model.Count Video Eşleşti)</span>
                </h5>
                
                <!-- Export to Excel -->
                <form asp-action="ExportCommentHunterToExcel" method="post">
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <input type="hidden" name="results[@i].VideoId" value="@Model[i].VideoId" />
                        <input type="hidden" name="results[@i].Title" value="@Model[i].Title" />
                        <input type="hidden" name="results[@i].ChannelName" value="@Model[i].ChannelName" />
                        <input type="hidden" name="results[@i].ViewCount" value="@Model[i].ViewCount" />
                        <input type="hidden" name="results[@i].CommentCount" value="@Model[i].CommentCount" />
                        <input type="hidden" name="results[@i].SampleComment" value="@Model[i].SampleComment" />
                    }
                    <button type="submit" class="btn btn-success btn-sm shadow-sm d-flex align-items-center gap-2">
                        <i class="bi bi-file-earmark-excel"></i> Excel İndir
                    </button>
                </form>
            </div>

            <!-- Data Table -->
            <div class="table-responsive">
                <table class="table table-hover align-middle border">
                    <thead class="table-light text-muted">
                        <tr>
                            <th style="width: 25%;">Video & Kanal</th>
                            <th class="text-center">İzlenme</th>
                            <th class="text-center">Eşleşen Yorum</th>
                            <th style="width: 40%;">Örnek Yorum</th>
                            <th class="text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex flex-column">
                                        <small class="fw-semibold text-dark text-truncate" style="max-width: 250px;" title="@item.Title">@item.Title</small>
                                        <small class="text-muted"><i class="bi bi-person-video"></i> @item.ChannelName</small>
                                    </div>
                                </td>
                                <td class="text-center"><span class="badge bg-light text-dark border">@item.ViewCount?.ToString("N0")</span></td>
                                <td class="text-center"><span class="badge bg-danger text-light shadow-sm">@item.CommentCount</span></td>
                                <td>
                                    <div class="bg-light p-2 rounded small text-muted fst-italic text-truncate" style="max-width: 350px;" title="@item.SampleComment">
                                        "@item.SampleComment"
                                    </div>
                                </td>
                                <td class="text-end">
                                    <a href="https://www.youtube.com/watch?v=@item.VideoId" target="_blank" class="btn btn-outline-danger btn-sm rounded-pill px-3">Aç</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}